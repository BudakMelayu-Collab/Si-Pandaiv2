rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // AUTH HELPERS
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    // AUTH tokens NEVER contain custom claims. Look up roles using a trusted document.
    function isAdmin() {
      return isVerified() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'muhammad.nawa@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // SCHEMA HELPERS
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // VALIDATION HELPERS
    function isValidRecipient(data) {
      return data.keys().hasAll(['name', 'nik', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.nik is string
        && data.createdAt == request.time
        && data.updatedAt == request.time;
    }

    function isValidRecipientUpdate(data) {
      return data.get('name', '') is string && data.get('name', '').size() <= 200
        && data.get('nik', '') is string
        && data.updatedAt == request.time;
    }

    function isValidSystemLog(data) {
      return data.keys().hasAll(['email', 'name', 'action', 'target', 'details', 'createdAt'])
        && data.email is string
        && data.name is string
        && data.action is string
        && data.target is string
        && data.details is string
        && data.createdAt == request.time;
    }

    // RECIPIENTS
    match /recipients/{recipientId} {
      // Pillar 8: Secure List Queries. Evaluate resource.data.
      allow list: if isVerified(); 
      allow get: if isVerified() && isValidId(recipientId);
      
      allow create: if isValidId(recipientId) && isValidRecipient(incoming());
      
      allow update: if isVerified() && isValidRecipientUpdate(incoming())
        && incoming().get('createdAt', null) == existing().get('createdAt', null)
        && (
          isAdmin() || 
          // Action: Update Basic Data
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'nik', 'kk', 'pob', 'dob', 'gender', 'familyStatus', 'headOfFamilyName',
            'headOfFamilyDob', 'address', 'rt', 'rw', 'kampung', 'district', 'registrationId',
            'source', 'institutionName', 'personInCharge', 'sector', 'subSector', 'aidType', 'programName', 'purpose', 'amountProposed',
            'contact', 'companion', 'submissionDate', 'surveyDate', 'disbursementDate', 'amountDisbursed',
            'schoolName', 'schoolLevel', 'schoolClass', 'schoolAddress', 'schoolPhone', 
            'bankAccountNo', 'bankName', 'bankAccountHolder', 'status', 'notes', 'isTermsAccepted',
            'skmp', 'documentStatus', 'documentStatusNotes', 'documents',
            'hasSignedPdf', 'hasSignedReceiptPdf', 'hasSignedMPZISPdf', 'hasSignedSurveyPdf',
            'signedPdfUrl', 'signedReceiptPdfUrl', 'signedMPZISPdfUrl', 'signedSurveyPdfUrl',
            'isMPZISGenerated', 'isEPPDGenerated',
            'serviceType', 'monthlyPaymentStatus', 'monthlyPaymentNote',
            'rsBedId', 'rsCheckInDate', 'rsNoReg', 'rsEstimatedCheckOutDate', 'rsCheckOutDate', 'rsMedicalNotes', 'rsStatus', 'rsCompanionName', 'rsCompanionRelation', 'rsHospital', 'rsJenisRawatan',
            'updatedAt'
          ])
        );
      
      allow delete: if isVerified();
      
      match /templates/{templateId} {
        allow read: if isVerified();
        allow write: if isVerified() && isValidId(templateId);
      }
      match /scans/{scanId} {
        allow read: if isVerified();
        allow write: if isValidId(scanId);
      }
    }

    // OCR SESSIONS
    match /ocr_sessions/{sessionId} {
      allow read, write: if sessionId.size() > 0;
    }

    // PPD RECORDS
    match /ppd_records/{recordId} {
      allow list: if isVerified();
      allow get: if isVerified() && isValidId(recordId);
      allow create: if isVerified() && isValidId(recordId) && incoming().createdAt == request.time;
      allow update: if isVerified() && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // COMPANION REPORTS
    match /companionReports/{reportId} {
      allow list: if isVerified();
      allow get: if isVerified() && isValidId(reportId);
      allow create: if isVerified() && isValidId(reportId) && incoming().uploaderId == request.auth.uid;
      allow update: if isVerified() && existing().uploaderId == request.auth.uid;
      allow delete: if isAdmin() || (isVerified() && existing().uploaderId == request.auth.uid);
    }

    // MONTHLY PAYMENTS
    match /monthly_payments/{paymentId} {
      allow list: if isVerified();
      allow get: if isVerified() && isValidId(paymentId);
      allow create: if isVerified() && isValidId(paymentId) && incoming().createdAt == request.time;
      allow update: if isVerified() && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin();
    }

    // ASSESSMENTS
    match /assessments/{assessmentId} {
      allow list: if isVerified();
      allow get: if isVerified() && isValidId(assessmentId);
      allow create: if isVerified() && isValidId(assessmentId) && incoming().createdAt == request.time;
      allow update: if isVerified() && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // ANNOUNCEMENTS
    match /announcements/{announcementId} {
      allow list, get: if isVerified();
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{settingId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }

    // USER CONFIGS
    match /user_configs/{configId} {
      allow list: if isVerified();
      allow get: if isVerified() && isValidId(configId);
      allow create: if isAdmin() && isValidId(configId) && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(configId) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // SYSTEM AUDIT LOGS
    match /system_logs/{logId} {
      allow list: if isVerified();
      allow get: if isVerified() && isValidId(logId);
      allow create: if isVerified() && isValidId(logId) && isValidSystemLog(incoming());
      allow update, delete: if false; // Audit logs must be completely immutable to prevent tampering
    }

    // ADMINS (Only Admins can manage other admins)
    match /admins/{userId} {
      allow read: if isVerified();
      allow write: if isAdmin();
    }
  }
}
