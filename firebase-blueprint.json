{
  "entities": {
    "Recipient": {
      "title": "Recipient",
      "description": "Information about social aid recipients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nik": { "type": "string" },
        "kk": { "type": "string" },
        "pob": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string", "enum": ["Laki-laki", "Perempuan"] },
        "familyStatus": { "type": "string" },
        "headOfFamilyName": { "type": "string" },
        "headOfFamilyDob": { "type": "string" },
        "address": { "type": "string" },
        "rt": { "type": "string" },
        "rw": { "type": "string" },
        "kampung": { "type": "string" },
        "district": { "type": "string" },
        "registrationId": { "type": "string" },
        "source": { "type": "string" },
        "sector": { "type": "string" },
        "subSector": { "type": "string" },
        "aidType": { "type": "string" },
        "programName": { "type": "string" },
        "purpose": { "type": "string" },
        "amountProposed": { "type": "number" },
        "contact": { "type": "string" },
        "companion": { "type": "string" },
        "submissionDate": { "type": "string" },
        "surveyDate": { "type": "string" },
        "disbursementDate": { "type": "string" },
        "amountDisbursed": { "type": "number" },
        "schoolName": { "type": "string" },
        "schoolLevel": { "type": "string" },
        "schoolClass": { "type": "string" },
        "schoolAddress": { "type": "string" },
        "schoolPhone": { "type": "string" },
        "bankAccountNo": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAccountHolder": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "isTermsAccepted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "nik", "registrationId", "status"]
    },
    "PPDRecord": {
      "title": "PPD Record",
      "description": "Records of PPD generation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "no": { "type": "string" },
        "date": { "type": "string" },
        "requestedBy": { "type": "string" },
        "amount": { "type": "number" },
        "proposeFor": { "type": "string" },
        "recipientId": { "type": "string" },
        "signedPdfUrl": { "type": "string", "description": "Base64 encoded PDF (Max 1MB)" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["no", "recipientId"]
    },
    "companionReports": {
      "title": "Companion Monthly Report",
      "description": "Monthly reports uploaded by program companions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companionId": { "type": "string" },
        "companionName": { "type": "string" },
        "month": { "type": "string" },
        "year": { "type": "number" },
        "reportType": { "type": "string", "enum": ["Bulanan", "Program"] },
        "sector": { "type": "string", "enum": ["Siak Cerdas", "Siak Dakwah", "Siak Peduli", "Siak Sehat", "Siak Sejahtera"] },
        "title": { "type": "string" },
        "coverUrl": { "type": "string" },
        "fileUrl": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" },
        "uploaderId": { "type": "string" }
      },
      "required": ["companionId", "month", "year", "title", "coverUrl"]
    },
    "MonthlyPayment": {
      "title": "Monthly Payment Tracking",
      "description": "Monthly payment tracking for various sector beneficiaries",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sector": { "type": "string" },
        "programName": { "type": "string" },
        "registrationId": { "type": "string" },
        "asnaf": { "type": "string" },
        "name": { "type": "string" },
        "nik": { "type": "string" },
        "contact": { "type": "string" },
        "level": { "type": "string" },
        "schoolName": { "type": "string" },
        "disbursementDate": { "type": "string" },
        "budget": { "type": "number" },
        "fundingSource": { "type": "string" },
        "bankAccountNo": { "type": "string" },
        "bankAccountName": { "type": "string" },
        "bankName": { "type": "string" },
        "monthControl": { "type": "string" },
        "january": { "type": "boolean" },
        "februari": { "type": "boolean" },
        "maret": { "type": "boolean" },
        "april": { "type": "boolean" },
        "mei": { "type": "boolean" },
        "juni": { "type": "boolean" },
        "juli": { "type": "boolean" },
        "agustus": { "type": "boolean" },
        "september": { "type": "boolean" },
        "oktober": { "type": "boolean" },
        "november": { "type": "boolean" },
        "desember": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sector", "programName", "name", "registrationId"]
    },
    "Assessment": {
      "title": "Social Aid Assessment",
      "description": "Scoring and assessments for aid recipients based on official template",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "recipientName": { "type": "string" },
        "date": { "type": "string" },
        "aidType": { "type": "string" },
        "requestedFor": { "type": "string" },
        "requestedAmount": { "type": "number" },
        "schoolName": { "type": "string" },
        "grade": { "type": "string" },
        "village": { "type": "string" },
        "district": { "type": "string" },
        "surveyDate": { "type": "string" },
        "job": { "type": "string" },
        "fatherHusband": { "type": "string" },
        "motherWife": { "type": "string" },
        "gardenFarm": { "type": "string" },
        "houseOwnership": { "type": "string" },
        "debt": { "type": "string" },
        "schoolDependents": { "type": "string" },
        "assessorName": { "type": "string" },
        "economicScore": { "type": "number" },
        "socialScore": { "type": "number" },
        "healthScore": { "type": "number" },
        "housingScore": { "type": "number" },
        "educationScore": { "type": "number" },
        "totalScore": { "type": "number" },
        "recommendation": { "type": "string" },
        "explanation": { "type": "string" },
        "photos": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["recipientId", "aidType", "village", "district"]
    },
    "SurveyTemplateConfig": {
      "title": "Survey Template Configuration",
      "description": "Global settings for the survey template branding",
      "type": "object",
      "properties": {
        "logo": { "type": "string" },
        "institution": { "type": "string" },
        "region": { "type": "string" },
        "subText": { "type": "string" },
        "fontSize": { "type": "number" },
        "logoSize": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserConfig": {
      "title": "User Configurations",
      "description": "Menu visibility and role configuration for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "allowedMenus": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "allowedMenus"]
    },
    "SystemLog": {
      "title": "System Logs",
      "description": "Log records of crucial user actions for audit trail and transparency",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "action": { "type": "string" },
        "target": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "action", "target", "details", "createdAt"]
    }
  },
  "firestore": {
    "/system_logs/{logId}": {
      "schema": "SystemLog",
      "description": "Collection of user audit logs and action logs"
    },
    "/user_configs/{configId}": {
      "schema": "UserConfig",
      "description": "Collection of user role and menu configurations"
    },
    "/monthly_payments/{paymentId}": {
      "schema": "MonthlyPayment",
      "description": "Collection of monthly payment tracking for all sectors"
    },
    "/companionReports/{reportId}": {
      "schema": "companionReports",
      "description": "Collection of monthly reports from companions"
    },
    "/recipients/{recipientId}": {
      "schema": "Recipient",
      "description": "Collection of aid recipients"
    },
    "/assessments/{assessmentId}": {
      "schema": "Assessment",
      "description": "Collection of assessments for aid recipients"
    },
    "/recipients/{recipientId}/templates/{templateId}": {
      "schema": "object",
      "description": "Template-specific data (survey, memo, eppd)"
    },
    "/ppd_records/{recordId}": {
      "schema": "PPDRecord",
      "description": "Collection of PPD generation records"
    },
    "/announcements/{announcementId}": {
      "schema": "object",
      "description": "Collection of system announcements"
    },
    "/settings/app": {
      "schema": "object",
      "description": "Global application settings"
    },
    "/settings/survey_template": {
      "schema": "SurveyTemplateConfig",
      "description": "Global survey template branding configuration"
    },
    "/recipients/{recipientId}/scans/{scanId}": {
      "schema": "object",
      "description": "Storage for document scans (base64)"
    }
  }
}
